{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "crons": [
    { "path": "/api/cron/debt-reminders", "schedule": "30 23 * * *" },
    { "path": "/api/cron/debt-reminders/retry", "schedule": "30 0 * * *" },
    { "path": "/api/cron/debt-reminders/evening", "schedule": "30 12 * * *" },
    { "path": "/api/cron/debt-reminders/evening-retry", "schedule": "30 13 * * *" }
  ]
}
