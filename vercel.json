{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "crons": [
    { "path": "/api/cron/debt-reminders", "schedule": "0 1 * * *" },
    { "path": "/api/cron/debt-reminders/retry", "schedule": "0 2 * * *" },
    { "path": "/api/cron/debt-reminders/evening", "schedule": "0 14 * * *" },
    { "path": "/api/cron/debt-reminders/evening-retry", "schedule": "0 15 * * *" }
  ]
}
